# .env.example — NEVER commit the real .env file to git!
# Copy this file to .env and fill in your real values.

# 1. Get a free RPC URL from https://alchemy.com or https://infura.io
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# 2. Export your wallet private key from MetaMask
#    MetaMask → Account → three dots → Account Details → Export Private Key
#    Use a dedicated TEST wallet — never your main wallet!
PRIVATE_KEY=0xYOUR_WALLET_PRIVATE_KEY_HERE

# 3. Get a free API key from https://etherscan.io/myapikey
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# 4. Optional: set to "true" to see gas costs per function
REPORT_GAS=false
